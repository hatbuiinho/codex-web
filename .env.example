# Absolute path to the directory Codex is allowed to work in.
# On Ubuntu, make sure UID 1000 can read and write this directory.
CODEX_WORKSPACE_PATH=/srv/codex-workspace
CODEX_WEB_PUBLIC_ORIGIN=https://codex.example.com

# Pin these values for reproducible builds; bump them deliberately when needed.
NODE_VERSION=22.14.0
CODEX_VERSION=0.153.2
CODEX_WEB_TAG=local

# In-app authentication. Generate the secret with:
# openssl rand -base64 48
CODEX_WEB_AUTH_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
CODEX_WEB_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
CODEX_WEB_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password-of-at-least-12-characters
